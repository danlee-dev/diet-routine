{
  "expo": {
    "name": "DietRoutine",
    "slug": "diet-routine",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dietroutine",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "dev.danlee.dietroutine",
      "appleTeamId": "45JS5XMNVC",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDisplayName": "다루",
        "NSMotionUsageDescription": "걸음, 달리기 케이던스, 오른 높이를 정확하게 재려고 동작 정보를 사용합니다.",
        "NSSupportsLiveActivities": true,
        "CFBundleDevelopmentRegion": "ko"
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.dev.danlee.dietroutine"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FCFCFC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#0A0A0A",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "달리기와 걷기의 경로, 거리, 페이스를 기록하려고 위치를 사용합니다.",
          "locationAlwaysAndWhenInUsePermission": "화면이 잠겨 있어도 달리기 경로를 끊김 없이 기록하려고 위치를 사용합니다.",
          "locationAlwaysPermission": "화면이 잠겨 있어도 달리기 경로를 끊김 없이 기록하려고 위치를 사용합니다.",
          "isIosBackgroundLocationEnabled": true
        }
      ],
      "expo-task-manager",
      "expo-maps",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "걸음 수, 체중, 수면, 활동 에너지, 다른 앱의 운동을 읽어 오늘 기록을 채우고 기상 시간을 제안합니다.",
          "NSHealthUpdateUsageDescription": "앱에서 기록한 체중, 홈트, 달리기와 걷기(거리, 활동 에너지, 경로)를 건강 앱에 저장합니다.",
          "background": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "음식 사진과 성분표를 코치에게 보내려고 사진을 엽니다.",
          "cameraPermission": "음식, 메뉴판, 성분표를 찍어 코치에게 보내려고 카메라를 씁니다.",
          "microphonePermission": false
        }
      ],
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "0cb5671f-6c87-4aa8-91a8-ecf42aef4603"
      }
    },
    "owner": "danleedev",
    "updates": {
      "url": "https://u.expo.dev/0cb5671f-6c87-4aa8-91a8-ecf42aef4603",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
